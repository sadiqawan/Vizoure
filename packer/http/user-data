#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: vizoure-nms
    username: admin
    password: "$6$rounds=4096$vizoure$hash"  # will be overridden by install-nms.sh
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: lvm
  packages:
    - openssh-server
    - curl
    - wget
    - git
  late-commands:
    # ISS-01 fix (md/04): download to a file first, verify it's non-empty and
    # actually a shell script, THEN run it — never pipe curl straight into bash.
    - curtin in-target --target=/target -- curl -fsSL -o /tmp/install-nms.sh https://raw.githubusercontent.com/sadiqawan/Vizoure/main/scripts/install-nms.sh
    - curtin in-target --target=/target -- test -s /tmp/install-nms.sh
    - curtin in-target --target=/target -- bash -c "head -c2 /tmp/install-nms.sh | grep -q '#!'"
    - curtin in-target --target=/target -- bash /tmp/install-nms.sh
